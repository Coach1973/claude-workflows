## 📤 新增記憶後自動推送

```powershell
$repo = "$env:USERPROFILE\Documents\mac-openclaw-workflows"
$mem  = (Get-ChildItem "$env:USERPROFILE\.claude\projects" -Recurse -Filter "MEMORY.md" | Select-Object -First 1).DirectoryName
Copy-Item "$mem\*.md" $repo -Force
cd $repo
git add *.md
if (git status --porcelain) {
    git commit -m "Auto memory sync from $env:COMPUTERNAME @ $(Get-Date -Format 'yyyy-MM-dd HH:mm')"
    git push origin main --quiet
}
```
